{
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "\"$HOME/.claude/wezterm-attention/mark-thinking.sh\""
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "command": "\"$HOME/.claude/wezterm-attention/mark-thinking.sh\""
        }
      ]
    }
  ],
  "Notification": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "\"$HOME/.claude/wezterm-attention/write-marker.mjs\" notify"
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "\"$HOME/.claude/wezterm-attention/write-marker.mjs\" stop"
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "\"$HOME/.claude/wezterm-attention/write-marker.mjs\" clear"
        }
      ]
    }
  ]
}
